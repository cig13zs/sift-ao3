{
  "manifest_version": 3,
  "name": "Sift for AO3: block tags, mute authors, filter ships",
  "short_name": "Sift",
  "version": "2.0.0",
  "description": "Block tags, mute authors, and keep your ship first on every AO3 search. See kudos rates and hide fics you already opened.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://archiveofourown.org/*"],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-enabled": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Turn Sift on or off"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://archiveofourown.org/*"],
      "js": ["lib/sift.js", "lib/storage.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sift for AO3",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
